{
  "name": "vektor-web",
  "private": true,
  "version": "0.9.2",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --configLoader native",
    "dev:demo": "VITE_DEMO_MODE=true bun --bun vite --configLoader native",
    "build": "bun run typecheck && bun --bun vite build --configLoader native",
    "build:demo": "VITE_DEMO_MODE=true bun run build",
    "typecheck": "bun check",
    "test": "bun --bun vitest run --configLoader native --pool threads",
    "test:e2e": "bun run build && bun --bun playwright test",
    "generate:api": "bun --bun openapi-typescript ../docs/openapi-v1.yaml -o src/lib/api/openapi.d.ts"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@stylexjs/stylex": "0.19.2",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/react-query": "5.108.2",
    "lucide-react": "1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "0.19.2",
    "@vitejs/plugin-react": "6.3.0",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.8",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "happy-dom": "21.0.4",
    "@playwright/test": "1.65.1",
    "@axe-core/playwright": "4.14.0"
  }
}

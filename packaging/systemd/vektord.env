# Vektor daemon configuration (/etc/vektor/vektord.env)
# Uncomment and adjust as needed, then run: sudo systemctl restart vektord

# HTTP listen address (default: 127.0.0.1:8080)
# VEKTOR_HTTP_ADDR=127.0.0.1:8080

# External origin when serving behind a reverse proxy or LAN IP
# VEKTOR_PUBLIC_ORIGIN=https://vektor.homelab.local

# Optional direct TLS
# VEKTOR_TLS_CERT=/etc/vektor/cert.pem
# VEKTOR_TLS_KEY=/etc/vektor/key.pem

# Collection & session tuning
# VEKTOR_PERSIST_INTERVAL=10s
# VEKTOR_LIVE_INTERVAL=1s
# VEKTOR_DISCOVERY_INTERVAL=60s
# VEKTOR_SESSION_TTL=24h
# VEKTOR_LOG_LEVEL=info
